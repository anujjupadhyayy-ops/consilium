{
  "lens": "Operational capacity, process impact, licence & 3PP-kit inventory, supplier SLA control.",
  "rules_summary": [
    "Operational Health = the WEAKEST of four signals (capacity, 3PP spend, savings delivery, supplier/SLA & licence-kit) -- never an average.",
    "Any signal RED => Blocker, regardless of the other three.",
    "Weakest signal AMBER, none RED => Conditional.",
    "All four signals GREEN => Yes."
  ],
  "user_overridable": true,
  "trigger_keywords": [
    "capacity",
    "licence",
    "license",
    "sla",
    "kit",
    "resourcing",
    "operational",
    "supplier"
  ],
  "capacity_amber_threshold_pct": 90.0,
  "capacity_red_threshold_pct": 100.0,
  "spend_amber_threshold_pct": 95.0,
  "spend_red_threshold_pct": 100.0,
  "savings_amber_threshold_ratio": 0.9,
  "savings_red_threshold_ratio": 0.7,
  "rules": [
    {
      "id": "capacity_red",
      "description": "capacity utilisation {capacity_utilisation_pct_if_accepted:g}% (>={capacity_red_threshold_pct:g}% red line)",
      "fields": ["capacity_utilisation_pct_if_accepted"],
      "when": "capacity_utilisation_pct_if_accepted >= capacity_red_threshold_pct",
      "stance": "blocker",
      "keywords": ["capacity", "headcount", "overtime"]
    },
    {
      "id": "spend_red",
      "description": "third-party spend {third_party_spend_pct_of_budget:g}% of budget (>={spend_red_threshold_pct:g}% red line)",
      "fields": ["third_party_spend_pct_of_budget"],
      "when": "third_party_spend_pct_of_budget >= spend_red_threshold_pct",
      "stance": "blocker",
      "keywords": ["third-party spend", "third party spend", "3pp"]
    },
    {
      "id": "savings_red",
      "description": "savings delivery ratio {savings_delivery_ratio:g} (<{savings_red_threshold_ratio:g} red line)",
      "fields": ["savings_delivery_ratio"],
      "when": "savings_delivery_ratio < savings_red_threshold_ratio",
      "stance": "blocker",
      "keywords": ["savings", "cost reduction"]
    },
    {
      "id": "licence_not_provisioned",
      "description": "licence not provisioned for the new date",
      "fields": ["licence_provisioned_for_new_date"],
      "when": "licence_provisioned_for_new_date == False",
      "stance": "blocker",
      "keywords": ["licence", "license", "provisioned"]
    },
    {
      "id": "supplier_sla_not_in_place",
      "description": "supplier SLA not in place",
      "fields": ["supplier_sla_in_place"],
      "when": "supplier_sla_in_place == False",
      "stance": "blocker",
      "keywords": ["sla", "service level"]
    },
    {
      "id": "capacity_amber",
      "description": "capacity utilisation {capacity_utilisation_pct_if_accepted:g}% (>={capacity_amber_threshold_pct:g}% amber line)",
      "fields": ["capacity_utilisation_pct_if_accepted"],
      "when": "capacity_utilisation_pct_if_accepted >= capacity_amber_threshold_pct and capacity_utilisation_pct_if_accepted < capacity_red_threshold_pct",
      "stance": "conditional"
    },
    {
      "id": "spend_amber",
      "description": "third-party spend {third_party_spend_pct_of_budget:g}% of budget (>={spend_amber_threshold_pct:g}% amber line)",
      "fields": ["third_party_spend_pct_of_budget"],
      "when": "third_party_spend_pct_of_budget >= spend_amber_threshold_pct and third_party_spend_pct_of_budget < spend_red_threshold_pct",
      "stance": "conditional"
    },
    {
      "id": "savings_amber",
      "description": "savings delivery ratio {savings_delivery_ratio:g} (<{savings_amber_threshold_ratio:g} amber line)",
      "fields": ["savings_delivery_ratio"],
      "when": "savings_delivery_ratio < savings_amber_threshold_ratio and savings_delivery_ratio >= savings_red_threshold_ratio",
      "stance": "conditional"
    }
  ]
}
