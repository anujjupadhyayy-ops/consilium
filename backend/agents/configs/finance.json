{
  "lens": "Cost-of-service vs cost-of-delay, margin protection, 3PP budget mechanics.",
  "rules_summary": [
    "Margin erosion > 5pts => No.",
    "Any single supplier cost increase > 7% => No.",
    "3PP full-year forecast > 105% of budget => No (hard overspend line).",
    "3PP full-year forecast trips an early-warning threshold (80% at month 2, ramping to 100% at month 12) => Conditional, monitor.",
    "Otherwise => Yes."
  ],
  "user_overridable": true,
  "trigger_keywords": [
    "cost",
    "budget",
    "supplier",
    "margin",
    "3pp",
    "invoice",
    "price increase",
    "spend"
  ],
  "margin_erosion_threshold_pts": 5.0,
  "supplier_cost_increase_threshold_pct": 7.0,
  "generic_overspend_test_pct": 5.0,
  "early_forecast_month": 2,
  "early_forecast_threshold_pct": 80.0,
  "late_forecast_month": 12,
  "late_forecast_threshold_pct": 100.0,
  "cost_of_delay_note": "Cost-of-delay lens: weigh the margin/penalty exposure of proceeding against the revenue-at-risk exposure of not proceeding -- Delivery quantifies the schedule side of that trade-off.",
  "rules": [
    {
      "id": "supplier_cost_high",
      "description": "{supplier_cost_increase_pct:g}% supplier cost increase (>{supplier_cost_increase_threshold_pct:g}% threshold)",
      "fields": [
        "supplier_cost_increase_pct"
      ],
      "when": "supplier_cost_increase_pct > supplier_cost_increase_threshold_pct",
      "stance": "no",
      "label": "Supplier cost increase is too high",
      "threshold": {
        "key": "supplier_cost_increase_threshold_pct",
        "label": "supplier cost increase line",
        "unit": "%"
      }
    },
    {
      "id": "margin_erosion_high",
      "description": "{margin_erosion_pts:g}pt margin erosion (>{margin_erosion_threshold_pts:g}pt threshold)",
      "fields": [
        "margin_erosion_pts"
      ],
      "when": "margin_erosion_pts > margin_erosion_threshold_pts",
      "stance": "no",
      "label": "Project margin erosion is too high",
      "threshold": {
        "key": "margin_erosion_threshold_pts",
        "label": "project-margin floor",
        "unit": "pts"
      }
    },
    {
      "id": "forecast_hard_breach",
      "description": "{budget_forecast_utilisation_pct:g}% full-year 3PP forecast (>{hard_breach_threshold_pct:g}% hard breach line)",
      "fields": [
        "budget_forecast_utilisation_pct"
      ],
      "when": "budget_forecast_utilisation_pct > hard_breach_threshold_pct",
      "stance": "no",
      "label": "Full-year 3PP forecast breaches the budget hard line",
      "threshold": {
        "key": "generic_overspend_test_pct",
        "label": "overspend allowed above budget",
        "unit": "%"
      }
    },
    {
      "id": "forecast_early_warning",
      "description": "{budget_forecast_utilisation_pct:g}% full-year 3PP forecast in month {fy_month_elapsed} (early-concern threshold {forecast_concern_threshold_pct:g}%)",
      "fields": [
        "budget_forecast_utilisation_pct",
        "fy_month_elapsed"
      ],
      "when": "budget_forecast_utilisation_pct >= forecast_concern_threshold_pct",
      "stance": "conditional",
      "label": "Full-year 3PP forecast is above the early-warning line",
      "threshold": {
        "key": "early_forecast_threshold_pct",
        "label": "early-warning line at month 2",
        "unit": "%"
      }
    }
  ]
}
