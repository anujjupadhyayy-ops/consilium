# Model layer -- every agent's narration, the Chief of Staff's routing, and
# reconciliation all call this (model/llm.py). OpenAI-compatible: change
# BASE_URL to point at any endpoint that speaks the OpenAI HTTP shape.
# No model reachable? Every run still completes via the deterministic
# fallback path (see README "Status").
#
# Example for a local Ollama server (verified working):
#   MODEL_PROVIDER=oss
#   MODEL_NAME=llama3.2
#   BASE_URL=http://localhost:11434/v1
#   API_KEY=not-needed-for-local
#
# Example for Groq (free tier, fast -- get a key at console.groq.com):
#   MODEL_PROVIDER=groq
#   MODEL_NAME=openai/gpt-oss-120b
#   BASE_URL=https://api.groq.com/openai/v1
#   API_KEY=gsk_...
MODEL_PROVIDER=openai
MODEL_NAME=gpt-4o-mini
BASE_URL=
API_KEY=

# LangSmith tracing (optional -- skipped cleanly if no key; you cannot
# debug multi-agent blind, and the traces become showcase screenshots).
# Get a free-tier key at https://smith.langchain.com.
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=consilium
