# Model layer (wired in P1, not called at runtime until P2 -- agents are
# hard-coded stubs in P1). OpenAI-compatible: change BASE_URL to point at
# any self-hosted/OSS endpoint that speaks the OpenAI HTTP shape.
MODEL_PROVIDER=openai
MODEL_NAME=gpt-4o-mini
BASE_URL=
API_KEY=

# LangSmith tracing (enabled from P1, per the Build Brief -- you cannot
# debug multi-agent blind, and the traces become showcase screenshots).
# Get a free-tier key at https://smith.langchain.com.
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=consilium-p1
