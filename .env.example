# Model layer -- every agent's extraction and narration, and the Chief of
# Staff's reconciliation wording, all call this (model/llm.py). OpenAI-compatible: change
# BASE_URL to point at any endpoint that speaks the OpenAI HTTP shape.
# No model reachable? Every run still completes via the deterministic
# fallback path (see README "How it works").
#
# Example for a local Ollama server (verified working):
#   MODEL_PROVIDER=oss
#   MODEL_NAME=llama3.2
#   BASE_URL=http://localhost:11434/v1
#   API_KEY=not-needed-for-local
#
# Example for Groq (free tier, fast -- get a key at console.groq.com):
#   MODEL_PROVIDER=groq
#   MODEL_NAME=openai/gpt-oss-120b
#   BASE_URL=https://api.groq.com/openai/v1
#   API_KEY=gsk_...
MODEL_PROVIDER=openai
MODEL_NAME=gpt-4o-mini
BASE_URL=
API_KEY=

# P3.6: conservative ceiling on a free-text message's estimated token count
# for per-agent fact extraction. The whole message always goes to every
# agent -- never chunked -- so a message estimated over this fails with a
# clear error rather than being silently truncated. Raise it only if your
# model's context window genuinely supports more.
MODEL_CONTEXT_TOKENS=8000

# LangSmith tracing -- OPTIONAL and OFF by default. Turning it on sends each
# run's inputs and outputs (the text of your decision) to LangSmith, so it is
# opt-in: set LANGCHAIN_TRACING_V2=true AND a key (free tier at
# https://smith.langchain.com). With tracing on but no key it is switched off
# at startup rather than failing on every run.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=consilium
